---
import Base from '../../layouts/Base.astro';
import { sambas, slugify } from '../../lib/sambas';

export function getStaticPaths() {
  return sambas.map((s) => ({ params: { slug: s.slug }, props: { samba: s } }));
}

const { samba } = Astro.props;
const compositoresTexto = samba.compositores.join(', ');
---

<Base
  title={`${samba.titulo} | Sambas Lado B`}
  description={`${samba.titulo}, de ${compositoresTexto}.`}
>
  <a href="/" class="text-sm text-gold hover:underline">← Todos os sambas</a>

  <h1 class="mt-4 font-serif text-4xl text-gold sm:text-5xl">{samba.titulo}</h1>

  <dl class="mt-8 grid gap-6 sm:grid-cols-2">
    <div>
      <dt class="text-sm text-cream/60">Compositores</dt>
      <dd class="mt-1 text-xl">
        {
          samba.compositores.map((c, i) => (
            <>
              <a href={`/compositor/${slugify(c)}`} class="text-gold hover:underline">
                {c}
              </a>
              {i < samba.compositores.length - 1 && ' · '}
            </>
          ))
        }
      </dd>
    </div>
    {
      samba.cantor && (
        <div>
          <dt class="text-sm text-cream/60">Gravação</dt>
          <dd class="mt-1 text-xl">{samba.cantor}</dd>
        </div>
      )
    }
    {
      samba.disco && (
        <div>
          <dt class="text-sm text-cream/60">Disco</dt>
          <dd class="mt-1 text-xl">
            {samba.disco}
            {samba.ano && <span class="text-cream/60"> ({samba.ano})</span>}
          </dd>
        </div>
      )
    }
  </dl>

  {
    samba.youtube && (
      <div class="mt-10 aspect-video w-full overflow-hidden rounded-xl border border-gold/30">
        <iframe
          class="h-full w-full"
          src={`https://www.youtube-nocookie.com/embed/${samba.youtube}`}
          title={`${samba.titulo} no YouTube`}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    )
  }

  <section class="mt-10 rounded-xl border border-gold/30 bg-ink/40 p-6">
    <h2 class="font-serif text-2xl text-gold">Letra da música</h2>
    {
      samba.letra ? (
        <p class="mt-5 whitespace-pre-line text-base leading-8 text-cream">{samba.letra}</p>
      ) : (
        <p class="mt-4 text-cream/70">
          A letra ainda não foi disponibilizada nesta página.
          Estamos cadastrando letras autorizadas pelos titulares dos direitos autorais.
        </p>
      )
    }
  </section>
</Base>
